# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/BlogPlatform?retryWrites=true&w=majority

# Optional: comma-separated allowed frontend origins for CORS (only needed for split deployments)
# FRONTEND_URL=https://your-app.vercel.app

# Optional: override API base URL for the frontend (only needed for split deployments)
# REACT_APP_API_URL=https://your-backend.vercel.app
